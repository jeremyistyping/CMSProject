# ================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ================================================================
# Copy this file to .env.production and update with your values
# NEVER commit .env.production to version control!
# ================================================================

# Project Configuration
# ======================
COMPOSE_PROJECT_NAME=accounting_app

# Server Configuration
# ====================
# IMPORTANT: Replace YOUR_VPS_IP_HERE with your actual VPS IP address
# Examples:
#   - IP only: http://192.168.1.100
#   - With domain: https://accounting.yourdomain.com
SERVER_HOST=http://YOUR_VPS_IP_HERE

# Port Configuration
HTTP_PORT=80
HTTPS_PORT=443

# Database Configuration
# ======================
# IMPORTANT: Change these to strong, unique values!
POSTGRES_DB=sistem_akuntansi_prod
POSTGRES_USER=accounting_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_20_CHARS

# Backend Configuration
# =====================
# IMPORTANT: Generate a strong random secret (min 32 characters)
# You can generate one with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_VERY_LONG_RANDOM_SECRET_KEY_FOR_PRODUCTION_MIN_32_CHARS

# Environment setting
ENVIRONMENT=production

# Development Flags
SKIP_BALANCE_RESET=false
ENABLE_LEGACY_PAYMENT_JOURNALS=true
ENABLE_SSOT_PAYMENT_JOURNALS=true

# CORS Configuration
# ==================
# Add your server host here (same as SERVER_HOST above)
# For multiple origins, separate with commas
# Examples:
#   - Single: http://192.168.1.100
#   - Multiple: http://192.168.1.100,https://accounting.yourdomain.com
ALLOWED_ORIGINS=${SERVER_HOST}

# Frontend Configuration
# ======================
# This should point to your backend API through nginx
# Format: ${SERVER_HOST}/api
# Examples:
#   - IP only: http://192.168.1.100/api
#   - With domain: https://accounting.yourdomain.com/api
NEXT_PUBLIC_API_URL=${SERVER_HOST}/api

# SSL Configuration (Optional - for domain with HTTPS)
# =====================================================
# Set to true when you have SSL certificate configured
ENABLE_SSL=false

# Backup Configuration
# ====================
BACKUP_DIR=/opt/backups/accounting_app
BACKUP_RETENTION_DAYS=30

# ================================================================
# DEPLOYMENT SCENARIOS
# ================================================================

# 📱 SCENARIO 1: IP Address Only (No Domain)
# -------------------------------------------
# SERVER_HOST=http://192.168.1.100
# ALLOWED_ORIGINS=http://192.168.1.100
# NEXT_PUBLIC_API_URL=http://192.168.1.100/api
# ENABLE_SSL=false

# 🌐 SCENARIO 2: With Domain Name (HTTP)
# ---------------------------------------
# SERVER_HOST=http://accounting.company.com
# ALLOWED_ORIGINS=http://accounting.company.com
# NEXT_PUBLIC_API_URL=http://accounting.company.com/api
# ENABLE_SSL=false

# 🔒 SCENARIO 3: With Domain Name (HTTPS)
# ----------------------------------------
# SERVER_HOST=https://accounting.company.com
# ALLOWED_ORIGINS=https://accounting.company.com
# NEXT_PUBLIC_API_URL=https://accounting.company.com/api
# ENABLE_SSL=true

# 🔄 SCENARIO 4: Migration (IP + Domain)
# ---------------------------------------
# During migration, allow both IP and domain
# ALLOWED_ORIGINS=http://192.168.1.100,https://accounting.company.com

# ================================================================
# SECURITY CHECKLIST
# ================================================================
# 
# ✅ Change POSTGRES_PASSWORD to strong password (min 20 chars)
# ✅ Change JWT_SECRET to random string (min 32 chars)
# ✅ Update SERVER_HOST with your VPS IP or domain
# ✅ Never commit .env.production to Git
# ✅ Keep backup of .env.production in secure location
# ✅ Rotate secrets regularly (every 90 days recommended)
# ✅ Use HTTPS in production (ENABLE_SSL=true)
# ✅ Restrict SSH access to VPS
# ✅ Enable firewall on VPS
# ✅ Regular security updates
#
# ================================================================
