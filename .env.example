# ================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ================================================================
# This is for local development only
# For production deployment, use .env.production.example
# ================================================================

# Project Configuration
COMPOSE_PROJECT_NAME=accounting_app_dev

# Server Configuration (Local Development)
SERVER_HOST=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Database Configuration (Local Development)
POSTGRES_DB=sistem_akuntansi_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend Configuration (Local Development)
JWT_SECRET=development-secret-key-change-in-production
ENVIRONMENT=development
SKIP_BALANCE_RESET=true
ENABLE_LEGACY_PAYMENT_JOURNALS=true
ENABLE_SSOT_PAYMENT_JOURNALS=true

# CORS Configuration (Local Development)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration (Local Development)
NEXT_PUBLIC_API_URL=http://localhost:8080

# SSL Configuration (Disabled for local development)
ENABLE_SSL=false

# Backup Configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# ================================================================
# NOTE: This is for LOCAL DEVELOPMENT only!
# For VPS deployment, copy .env.production.example to .env.production
# and update with your production values.
# ================================================================
